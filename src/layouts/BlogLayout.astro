---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader, { type NavItem } from "../components/SiteHeader.astro";
import firaSansSemibold from "../assets/fonts/fira-sans-semibold.woff2?url";

interface Props {
  title: string;
  description: string;
  canonical: string;
  /** Full document title. Defaults to "<title> — Thoughts by Christopher Kuhrt". */
  fullTitle?: string;
  nav?: NavItem[];
  /**
   * "shell" = centred 1280px column (blog pages).
   * "split" = sticky `aside` slot on the left, content + footer card on the right (start page).
   */
  layout?: "shell" | "split";
}

const {
  title,
  description,
  canonical,
  fullTitle = `${title} — Thoughts by Christopher Kuhrt`,
  nav,
  layout = "shell",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="preload"
      href={firaSansSemibold}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader nav={nav} />
    {
      layout === "split" ? (
        <div class="split-page">
          <div class="split-page__aside">
            <slot name="aside" />
          </div>
          <main id="main" class="split-page__main">
            <slot />
          </main>
          <SiteFooter variant="card" />
        </div>
      ) : (
        <>
          <main id="main" class="main-content">
            <div class="site-shell">
              <slot />
            </div>
          </main>
          <SiteFooter />
        </>
      )
    }
  </body>
</html>
