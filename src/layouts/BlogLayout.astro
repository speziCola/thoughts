---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import ArtPanel from "../components/ArtPanel.astro";
import firaSansSemibold from "../assets/fonts/fira-sans-semibold.woff2?url";
import ogDefault from "../assets/images/og-default.png";
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import { SITE_NAME, SITE_LOCALE, SITE_ORIGIN, PERSON_ID, WEBSITE_ID, person, website } from "../lib/site";
import { url } from "../lib/url";

interface Props {
  title: string;
  description: string;
  canonical: string;
  /** Full document title. Defaults to "<title> – Chris Kuhrt" (short suffix keeps titles near 60 chars). */
  fullTitle?: string;
  /**
   * "shell" = centred 1280px column (blog pages).
   * "split" = sticky hero art (or a custom `aside` slot) on the left, content + footer card on the right (main pages).
   */
  layout?: "shell" | "split";
  /** Social share image. Defaults to the branded og-default.png. */
  image?: ImageMetadata;
  imageAlt?: string;
  /** Open Graph type. */
  ogType?: "website" | "article" | "profile";
  /** Article metadata (ogType "article"). */
  published?: Date;
  modified?: Date;
  tags?: string[];
  /** Extra JSON-LD nodes for this page, merged into the site @graph. */
  jsonLd?: Record<string, unknown>[];
  /** Breadcrumb trail (name + canonical URL), rendered as BreadcrumbList. */
  breadcrumbs?: { name: string; url: string }[];
  /** schema.org type of this page. */
  pageType?: "WebPage" | "ProfilePage" | "AboutPage" | "CollectionPage";
}

const {
  title,
  description,
  canonical,
  fullTitle = `${title} – Chris Kuhrt`,
  layout = "shell",
  image = ogDefault,
  imageAlt = "Chris Kuhrt – Design Leadership, Product Strategy, Design Systems",
  ogType = "website",
  published,
  modified,
  tags = [],
  jsonLd = [],
  breadcrumbs,
  pageType = "WebPage",
} = Astro.props;

// Staging copies (github.io) set SITE_NOINDEX=true so they don't compete with chriskuhrt.de.
const noindex = import.meta.env.SITE_NOINDEX === "true";

// Share images: 1200px wide JPEG (best supported by LinkedIn, X, Slack, WhatsApp).
const og = await getImage({ src: image, width: Math.min(1200, image.width), format: "jpg", quality: 82 });
const ogWidth = og.attributes.width ?? Math.min(1200, image.width);
const ogHeight = og.attributes.height ?? Math.round((ogWidth * image.height) / image.width);
const ogUrl = new URL(og.src, SITE_ORIGIN).href;

const graph = [
  website,
  person,
  {
    "@type": pageType,
    "@id": `${canonical}#webpage`,
    url: canonical,
    name: fullTitle,
    description,
    inLanguage: "en",
    isPartOf: { "@id": WEBSITE_ID },
    about: { "@id": PERSON_ID },
    ...(pageType === "ProfilePage" ? { mainEntity: { "@id": PERSON_ID } } : {}),
    primaryImageOfPage: { "@type": "ImageObject", url: ogUrl, width: ogWidth, height: ogHeight },
    ...(breadcrumbs ? { breadcrumb: { "@id": `${canonical}#breadcrumb` } } : {}),
  },
  ...(breadcrumbs
    ? [
        {
          "@type": "BreadcrumbList",
          "@id": `${canonical}#breadcrumb`,
          itemListElement: breadcrumbs.map((crumb, i) => ({
            "@type": "ListItem",
            position: i + 1,
            name: crumb.name,
            item: crumb.url,
          })),
        },
      ]
    : []),
  ...jsonLd,
];
// Escape "<" so content can never close the script element.
const ldJson = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <meta name="author" content="Chris Kuhrt" />
    <meta name="theme-color" content="#f4f1ef" />
    <script is:inline>
      // Theme before first paint (no flash): the visitor's saved choice, otherwise the system setting.
      (() => {
        const root = document.documentElement;
        const meta = document.querySelector('meta[name="theme-color"]');
        const system = window.matchMedia("(prefers-color-scheme: dark)");
        const saved = () => {
          try {
            const value = localStorage.getItem("theme");
            return value === "light" || value === "dark" ? value : null;
          } catch {
            return null;
          }
        };
        const apply = (theme) => {
          root.dataset.theme = theme;
          if (meta) meta.content = theme === "dark" ? "#1a1a1a" : "#f4f1ef";
        };
        apply(saved() ?? (system.matches ? "dark" : "light"));
        // Follow the system live until the visitor picks a theme themselves.
        system.addEventListener("change", (event) => {
          if (!saved()) apply(event.matches ? "dark" : "light");
        });
      })();
    </script>
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={url("/favicon-48.png")} type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
    <link rel="alternate" type="application/rss+xml" title="Thoughts by Chris Kuhrt" href={url("/rss.xml")} />
    <link rel="sitemap" type="application/xml" href={url("/sitemap.xml")} />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={SITE_LOCALE} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(ogWidth)} />
    <meta property="og:image:height" content={String(ogHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    {ogType === "profile" && <meta property="profile:first_name" content="Chris" />}
    {ogType === "profile" && <meta property="profile:last_name" content="Kuhrt" />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {(modified ?? published) && <meta property="article:modified_time" content={(modified ?? published)!.toISOString()} />}
    {ogType === "article" && <meta property="article:author" content={`${SITE_ORIGIN}/about/`} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={ldJson} />
    <link
      rel="preload"
      href={firaSansSemibold}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    {
      layout === "split" ? (
        <div class="split-page">
          <div class="split-page__aside">
            <slot name="aside">
              <ArtPanel />
            </slot>
          </div>
          <main id="main" class="split-page__main">
            <slot />
          </main>
          <SiteFooter />
        </div>
      ) : (
        <>
          <main id="main" class="main-content">
            <div class="site-shell">
              <slot />
            </div>
          </main>
          <div class="site-footer-frame">
            <SiteFooter />
          </div>
        </>
      )
    }
  </body>
</html>
