---
import ArticleTeaser from "../components/ArticleTeaser.astro";
import Card from "../components/Card.astro";
import CardGrid from "../components/CardGrid.astro";
import SectionTitle from "../components/SectionTitle.astro";
import UxfCard from "../components/home/UxfCard.astro";
import BlogLayout from "../layouts/BlogLayout.astro";
import articleProcess from "../assets/images/article-process.png";
import articleSessions from "../assets/images/article-sessions.png";
import { url } from "../lib/url";

const canonical = "https://chriskuhrt.de/what-i-do/";

const services = [
  {
    title: "Product Strategy",
    description:
      "Framing ambiguous product problems before teams commit to expensive solutions.",
  },
  {
    title: "Alignment & Enablement",
    description:
      "Turning fragmented product teams into shared decisions, language and ways of working.",
  },
  {
    title: "Design Systems & DesignOps",
    description:
      "Unifying interaction patterns, foundations and workflows across products and frontend stacks.",
  },
];

const stages = [
  {
    name: "Establish Foundations",
    intro: "Before products improve, organizations need structure.",
    focus: "Build the Foundation",
    actions: [
      "Define UX vision and principles",
      "Establish governance and ownership",
      "Introduce research practices",
      "Build trust across leadership",
      "Define measurable success",
    ],
    outcome: "The goal is not better screens. It is organizational clarity.",
  },
  {
    name: "Align Direction",
    intro: "Great products require shared understanding.",
    focus: "Align Around Outcomes",
    actions: [
      "Connect UX with business strategy",
      "Facilitate product discovery",
      "Align stakeholders across teams",
      "Define measurable outcomes",
      "Prioritize customer value",
    ],
    outcome: "Alignment reduces waste long before development starts.",
  },
  {
    name: "Structure for Scale",
    intro: "With direction defined, I focus on scalable implementation.",
    focus: "Scale Design Operations",
    actions: [
      "Build and evolve design systems",
      "Standardize workflows",
      "Improve designer and developer collaboration",
      "Introduce reusable patterns",
      "Increase design maturity",
    ],
    outcome: "The goal is sustainable delivery across products and teams.",
  },
  {
    name: "Deliver, Measure, Evolve",
    intro: "Shipping is not the end. It is part of a continuous system.",
    focus: "Create Continuous Improvement",
    actions: [
      "Measure customer impact",
      "Run continuous user research",
      "Coach designers and product teams",
      "Refine governance and standards",
      "Scale successful practices",
    ],
    outcome: "Long-term success comes from continuous learning.",
  },
];

/* Operational view of "How I Work": same four-stage cards, shown via the switcher. */
const operationalStages = [
  {
    name: "Understand the Context",
    intro: "Before exploring solutions, I build a shared picture of the problem.",
    steps: [
      { title: "Understand Business Goals", text: "Clarify objectives and what success looks like." },
      { title: "Identify Stakeholders", text: "Map perspectives, responsibilities and expectations." },
      { title: "Assess Existing Knowledge", text: "Review research, data and feedback to find gaps." },
    ],
  },
  {
    name: "Discover & Define",
    intro: "I turn assumptions into evidence and define problems worth solving.",
    steps: [
      { title: "Research", text: "Explore user needs, behaviours and pain points." },
      { title: "Synthesize", text: "Find patterns and turn findings into insights." },
      { title: "Define", text: "Frame clear problems, priorities and success criteria." },
    ],
  },
  {
    name: "Explore & Validate",
    intro: "I explore different approaches and validate them before building.",
    steps: [
      { title: "Ideate", text: "Compare approaches through workshops and sketches." },
      { title: "Prototype", text: "Make ideas tangible enough to test." },
      { title: "Validate", text: "Test with users and refine based on evidence." },
    ],
  },
  {
    name: "Deliver & Iterate",
    intro: "Design doesn’t end with a validated concept.",
    steps: [
      { title: "Collaborate & Build", text: "Work with engineering to ship production-ready experiences." },
      { title: "Measure Impact", text: "Track usability, metrics and feedback against goals." },
      { title: "Iterate & Improve", text: "Use real-world insights to shape the next iteration." },
    ],
  },
];

const articles = [
  {
    title: "Conducting Effective Sessions Instead of Meetings",
    description:
      "I use visualization tools like Miro, Mural and FigJam to enhance meeting efficiency. By employing techniques like affinity mapping and user story/flow mapping, I ensure meetings are effective and inclusive, catering to diverse work environments. My priority is optimized communication and inclusion.",
    image: articleSessions,
    alt: "A digital whiteboard with clustered sticky notes from a mapping session",
    href: url("/thoughts/doing-sessions-instead-of-meetings/"),
  },
  {
    title: "Process optimization to deliver a better user experience",
    description:
      "The landscape of product development is constantly changing, highlighting the importance of teamwork, version management and the ability to scale effectively to improve the user experience. In response, I have taken the lead in implementing new tools in organizations to address these key aspects.",
    image: articleProcess,
    alt: "A mind map of UX design activities such as research, personas and user testing",
    href: url("/thoughts/process-optimization-to-deliver-a-better-user-experience/"),
  },
];
---

<BlogLayout
  title="What I Do"
  fullTitle="What I Do: Design Leadership & Design Systems – Chris Kuhrt"
  breadcrumbs={[
    { name: "Home", url: "https://chriskuhrt.de/" },
    { name: "What I Do", url: canonical },
  ]}
  description="How I help product teams align strategy, build design foundations, scale UX and continuously improve."
  canonical={canonical}
  layout="split"
>
  <div class="what-i-do">
    <section aria-labelledby="what-i-do-title">
      <SectionTitle as="h1" id="what-i-do-title">What I Do</SectionTitle>

      <CardGrid as="ul" columns={3} gap="sm">
        {
          services.map((service) => (
            <Card as="li" padding="sm" class="service">
              <h2 class="page-title-sm">{service.title}</h2>
              <p class="page-body">{service.description}</p>
            </Card>
          ))
        }
      </CardGrid>
    </section>

    <section class="how-i-work" aria-labelledby="how-i-work-title">
      <SectionTitle id="how-i-work-title">How I Work</SectionTitle>
      <fieldset class="view-switch">
        <legend class="visually-hidden">Show stages</legend>
        <label>
          <input type="radio" name="how-i-work-view" value="strategic" id="view-strategic" checked />
          <span>Strategic</span>
        </label>
        <label>
          <input type="radio" name="how-i-work-view" value="operational" id="view-operational" />
          <span>Operational</span>
        </label>
      </fieldset>

      <p class="page-body what-i-do__intro stages--strategic">
        Scaling UX requires structure. My work follows four stages that help
        teams move from fragmented execution to aligned delivery.
      </p>
      <p class="page-body what-i-do__intro stages--operational">
        On a single product challenge, I work in four steps: from understanding
        the context to shipping a solution and improving it.
      </p>

      <CardGrid as="ol" columns={4} gap="md" class="stages stages--strategic" aria-label="Strategic stages">
        {
          stages.map((stage, index) => (
            <Card
              as="li"
              padding="md"
              class="stage"
              accent={`var(--foreground-stage0${index + 1})`}
            >
              <hgroup class="stage__heading">
                <p class="page-body stage__name">{stage.name}</p>
                <h3 class="page-title-md">Stage {index + 1}</h3>
              </hgroup>
              <p class="page-body">{stage.intro}</p>
              <div>
                <h4 class="page-title-sm stage__focus">{stage.focus}</h4>
                <ul class="page-body stage__actions">
                  {stage.actions.map((action) => <li>{action}</li>)}
                </ul>
              </div>
              <p class="page-body">{stage.outcome}</p>
            </Card>
          ))
        }
      </CardGrid>

      <CardGrid as="ol" columns={4} gap="md" class="stages stages--operational" aria-label="Operational stages">
        {
          operationalStages.map((stage, index) => (
            <Card
              as="li"
              padding="md"
              class="stage"
              accent={`var(--foreground-stage0${index + 1})`}
            >
              <hgroup class="stage__heading">
                <p class="page-body stage__name">{stage.name}</p>
                <h3 class="page-title-md">Stage {index + 1}</h3>
              </hgroup>
              <p class="page-body">{stage.intro}</p>
              {stage.steps.map((step) => (
                <div>
                  <h4 class="page-title-sm stage__focus">{step.title}</h4>
                  <p class="page-body">{step.text}</p>
                </div>
              ))}
            </Card>
          ))
        }
      </CardGrid>
    </section>

    <section aria-labelledby="enabling-people-title">
      <SectionTitle id="enabling-people-title">Enabling People</SectionTitle>

      <div class="enabling">
        <UxfCard headingLevel={3} />

        <CardGrid columns={2}>
          {
            articles.map((article) => (
              <ArticleTeaser {...article} headingLevel={3} />
            ))
          }
        </CardGrid>
      </div>
    </section>
  </div>
</BlogLayout>

<style>
  /* Figma "Devider" on this page is a spacer only: 98px desktop, 48px mobile. */
  .what-i-do > section + section {
    margin-top: clamp(48px, calc(36.4615px + 3.2051vw), 98px);
  }

  .what-i-do :is(h2, h3, h4, p):not(.section-title) {
    margin: 0;
  }

  .what-i-do__intro {
    padding-bottom: 16px;
    color: var(--foreground-regular);
  }

  /* Service cards */
  .service :global(.card__content) {
    gap: 4px;
  }

  .service h2 {
    color: var(--foreground-strong);
  }

  .service p {
    color: var(--foreground-regular);
  }

  /* Stage cards */
  .stage :global(.card__content) {
    gap: 16px;
  }

  .stage p,
  .stage__actions {
    color: var(--foreground-regular);
  }

  .stage__heading {
    position: relative;
  }

  .stage__heading::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(-1 * var(--card-padding));
    width: 6px;
    border-radius: 0 2px 2px 0;
    background: var(--card-accent);
    content: "";
  }

  .stage .stage__name,
  .stage__focus {
    color: var(--card-accent);
  }

  .stage h3 {
    color: var(--foreground-strong);
  }

  .stage__actions {
    margin: 0;
    padding-left: 21px;
    list-style: disc;
  }

  /* Strategic / Operational switcher. Radios, so it works without JS;
     :has() hides the inactive set (without :has support both sets show).
     provisional – design pending: styled from the mockup with existing tokens. */
  .view-switch {
    position: relative;
    margin: 0 0 16px;
    padding: 4px;
    display: inline-grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    gap: 0;
    min-width: min(100%, 308px);
    border: 0;
    border-radius: var(--radius-8);
    background: var(--background-card);
  }

  /* Sliding highlight behind the active option (both options are equal width). */
  .view-switch::before {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 4px;
    width: calc((100% - 8px) / 2);
    border-radius: var(--radius-4);
    background: var(--background-muted);
    box-shadow: var(--shadow-highlight);
    content: "";
    transition: transform 250ms cubic-bezier(0.44, 0, 0.56, 1);
  }

  .view-switch:has(#view-operational:checked)::before {
    transform: translateX(100%);
  }

  .view-switch label {
    position: relative;
    z-index: 1;
    cursor: pointer;
  }

  .view-switch input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .view-switch span {
    padding: 4px 16px;
    display: block;
    border-radius: var(--radius-4);
    color: var(--foreground-regular);
    font-family: var(--page-font-title);
    font-size: var(--page-small-size);
    line-height: 24px;
    text-align: center;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .view-switch input:checked + span {
    color: var(--foreground-strong);
  }

  /* Very subtle hover: a faint tint of the page colour, so it never reads
     as a second selected state. */
  .view-switch label:hover input:not(:checked) + span {
    background: color-mix(in srgb, var(--background-page) 30%, transparent);
  }

  .view-switch input:focus-visible + span {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .how-i-work:has(#view-strategic:checked) .stages--operational,
  .how-i-work:has(#view-operational:checked) .stages--strategic {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .view-switch span,
    .view-switch::before {
      transition: none;
    }
  }

  /* UX Freiburg card above the article teasers, same gap as the grid. */
  .enabling {
    display: grid;
    gap: 24px;
  }
</style>
