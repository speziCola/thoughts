---
import { getCollection, render } from "astro:content";
import BlogLayout from "../layouts/BlogLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection(
    "thoughts",
    ({ data }) => import.meta.env.DEV || !data.draft,
  );

  return Promise.all(
    posts.map(async (post) => {
      const { Content } = await render(post);
      return {
        params: { slug: post.id.replace(/\/index$/, "") },
        props: { post, Content },
      };
    }),
  );
}

const { post, Content } = Astro.props;
const body = post.body;
if (typeof body !== "string") {
  throw new Error(`Missing article body in ${post.filePath ?? post.id}.`);
}

const title = body.match(/^#\s+(.+)$/m)?.[1];
if (!title) {
  throw new Error(`Missing H1 title in ${post.filePath ?? post.id}.`);
}

const canonical = `https://chriskuhrt.de/thoughts/${post.id.replace(/\/index$/, "")}/`;
const date = post.data.date.toISOString().slice(0, 10);
const formattedDate = post.data.date.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
---

<BlogLayout title={title} description={post.data.description} canonical={canonical} layout="split">
  <article class="blog-article">
    <time class="post-date" datetime={date}>{formattedDate}</time>
    <Content />
  </article>
</BlogLayout>
