---
/**
 * Old address "/home/": shows the start page too (its canonical points to "/").
 *
 * Deliberately NOT a redirect. Until 2026-11-22 "/" forwarded to "/home/", and
 * browsers/CDN keep that old "/" for up to 10 minutes (GitHub Pages: max-age=600).
 * If "/home/" forwarded back to "/", those visitors would bounce between the two
 * forever. Rendering the page here can never loop; the logo and "Home" link to "/".
 * Can become a redirect to "/" later, once no one can still have the old "/" cached.
 */
import StartPage from "./index.astro";
---

<StartPage />
