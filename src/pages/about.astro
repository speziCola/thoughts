---
import portrait from "../assets/images/about-portrait.jpg";
import Card from "../components/Card.astro";
import SectionTitle from "../components/SectionTitle.astro";
import BlogLayout from "../layouts/BlogLayout.astro";

import arrowNarrowRightRaw from "../assets/icons/arrow-narrow-right.svg?raw";
import { url } from "../lib/url";

const canonical = "https://chriskuhrt.de/about/";
const arrowNarrowRight = arrowNarrowRightRaw.replace(/stroke="black"/g, 'stroke="currentColor"');
---

<BlogLayout
  title="About"
  fullTitle="About Chris Kuhrt – Design Leader & Design Systems Advocate"
  ogType="profile"
  pageType="ProfilePage"
  breadcrumbs={[
    { name: "Home", url: "https://chriskuhrt.de/" },
    { name: "About", url: canonical },
  ]}
  description="Design Leader, Product Strategist & Design Systems Advocate. I connect product, design and engineering and build the foundations that let teams deliver great product experiences."
  canonical={canonical}
  layout="split"
>
  <section class="about-page" aria-labelledby="about-title">
    <SectionTitle as="h1" id="about-title">About</SectionTitle>

    <Card as="div" width="full">
      <section class="about-page__intro" aria-labelledby="about-intro-title">
        <div class="about-page__intro-copy">
          <h2 class="page-title-md" id="about-intro-title">
            Hi, my name is Chris Kuhrt
          </h2>
          <p class="about-page__subtitle page-body">
            Design Leader, Product Strategist &amp; Design Systems Advocate.
          </p>
          <p class="page-body">
            With over 10 years of experience across finance, marketplaces and
            digital platforms, I’ve evolved from designing individual
            experiences to shaping the teams, systems and strategies behind
            them.
          </p>
          <p class="page-body">
            As Head of Research &amp; Design, I focus on connecting product,
            design and engineering to solve complex challenges, align
            fragmented product ecosystems and create meaningful business
            impact.
          </p>
          <p class="page-body">
            I believe great design is rarely just a craft problem. It’s usually
            a systems problem. That’s why I care about building scalable design
            foundations, improving how teams collaborate and turning UX into
            an organizational capability rather than an isolated function.
          </p>
        </div>
        <img
          class="about-page__portrait"
          src={portrait.src}
          alt="Portrait of Chris Kuhrt"
          width="512"
          height="512"
          loading="eager"
        />
      </section>

      <hr class="about-page__divider" />

      <section
        class="about-page__section about-page__experience-section"
        aria-labelledby="experience-title"
      >
        <h2 class="page-title-lg" id="experience-title">Experience</h2>
        <div class="about-page__experience">
          <section aria-labelledby="professional-experience-title">
            <h3 class="page-title-md" id="professional-experience-title">
              Professional Experience
            </h3>
            <ul class="page-body about-page__professional-list">
              <li>Etops</li>
              <li>PATRONAS / niiio finance group</li>
              <li>Chrono24</li>
              <li>Reservix</li>
            </ul>
            <section
              class="about-page__advisory"
              aria-labelledby="startup-experience-title"
            >
              <h3 class="page-title-md" id="startup-experience-title">
                Startups &amp; Advisory
              </h3>
              <ul class="page-body">
                <li>Betterahead</li>
                <li>Hammertime</li>
                <li>Biorenewables</li>
                <li>GeoSpin</li>
              </ul>
            </section>
            <a class="page-body about-page__timeline-link" href={url("/timeline/")}>
              <span>
                You can check out my timeline in detail{" "}
                <span class="about-page__timeline-here">here</span>.
              </span>
              <span class="about-page__timeline-arrow" aria-hidden="true" set:html={arrowNarrowRight} />
            </a>
          </section>
          <section aria-labelledby="client-experience-title">
            <h3 class="page-title-md" id="client-experience-title">
              Client &amp; Project Experience
            </h3>
            <ul class="page-body">
              <li>DFB</li>
              <li>SC Freiburg</li>
              <li>Disney</li>
              <li>Swisscom</li>
              <li>hr</li>
              <li>Die Rheinpfalz</li>
            </ul>
          </section>
        </div>
      </section>

      <hr class="about-page__divider" />

      <p class="page-body about-page__statement">
        From design systems to organizational design. I align teams, tools
        and strategy to ship better products.
      </p>

      <div class="about-page__details">
        <section class="about-page__section" aria-labelledby="expertise-title">
          <h2 class="page-title-lg" id="expertise-title">
            Areas of Expertise
          </h2>
          <ul class="page-body about-page__expertise">
            <li>B2B, B2C, SaaS, etc.</li>
            <li>Human-centered (HCD) and customer-focused (CX) solutions</li>
            <li>Product design</li>
            <li>Design systems</li>
            <li>
              User-centered organizational transformation and design maturity
            </li>
            <li>Strategic planning</li>
            <li>
              Agile methodologies focused on outcomes, Lean UX and design
              thinking
            </li>
            <li>
              Efficient stakeholder management, both internal and external
            </li>
            <li>
              User research incorporating both qualitative and quantitative
              methods
            </li>
            <li>
              Identifying and prioritizing opportunities and framing problems
            </li>
            <li>Information architecture and interaction design</li>
            <li>Compliance with standards for usability and accessibility</li>
          </ul>
        </section>

        <section class="about-page__section" aria-labelledby="industries-title">
          <h2 class="page-title-lg" id="industries-title">Industries</h2>
          <ul class="page-body">
            <li>Finance</li>
            <li>E-Commerce</li>
            <li>Big Data</li>
          </ul>
        </section>
      </div>

      <section class="about-page__contact" aria-label="Contact">
        <a
          class="button button--primary about-page__button"
          href="mailto:chris+hello@qrt.de"
        >
          Get in touch
        </a>
      </section>
    </Card>
  </section>
</BlogLayout>

<style>
  .about-page__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(180px, 320px);
    align-items: start;
    gap: clamp(32px, 5vw, 72px);
  }

  .about-page__intro-copy h2,
  .about-page__section h2 {
    margin: 0 0 8px;
    color: var(--foreground-strong);
  }

  .about-page__intro-copy p,
  .about-page__section > p,
  .about-page__statement {
    max-width: 800px;
    margin: 0 0 24px;
    color: var(--foreground-regular);
  }

  /* Name and subtitle sit directly on top of each other: no gap. */
  .about-page__intro-copy h2 {
    margin-bottom: 0;
  }

  .about-page__intro-copy .about-page__subtitle {
    margin-top: 0;
    margin-bottom: 32px;
    color: var(--foreground-strong);
  }

  .about-page__portrait {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: 50% 50% 0 50%;
    object-fit: cover;
  }

  .about-page__section {
    margin-top: clamp(48px, 6vw, 80px);
  }

  .about-page__divider {
    height: 1px;
    margin: clamp(40px, 5vw, 64px) 0;
    border: 0;
    background: var(--border-subtle);
  }

  .about-page__experience-section,
  .about-page__details .about-page__section {
    min-width: 0;
    margin-top: 0;
  }

  .about-page__experience {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: clamp(24px, 4vw, 48px);
  }

  .about-page__experience h3 {
    margin: 0 0 8px;
    color: var(--foreground-regular);
  }

  .about-page__section ul {
    margin: 0;
    padding-left: 24px;
    color: var(--foreground-regular);
  }

  .about-page__experience .about-page__professional-list {
    width: 50%; /* half the column: the boxes hug the company names */
    min-width: min(100%, 260px);
    padding: 0;
    display: grid;
    gap: 4px;
    list-style: none;
    margin-bottom: 24px;
  }

  .about-page__professional-list li {
    padding: 8px 12px;
    border-radius: var(--radius-4);
    background: var(--background-page);
  }

  .about-page__advisory {
    margin-bottom: 24px;
  }

  .about-page__statement {
    margin: 0;
    color: var(--foreground-strong);
    font-weight: var(--page-weight-regular);
  }

  .about-page__details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px;
    margin-top: 32px;
  }

  .about-page__expertise {
    column-gap: 40px;
  }

  .about-page__expertise li {
    break-inside: avoid;
    padding-bottom: 8px;
  }

  .about-page__contact {
    margin-top: clamp(32px, 4vw, 56px);
  }


  @container page (max-width: 667px) {
    .about-page__intro {
      grid-template-columns: 1fr;
    }

    .about-page__portrait {
      width: 144px;
      justify-self: end;
      grid-row: 1;
    }

    .about-page__experience,
    .about-page__details {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .about-page__details .about-page__section {
      min-width: 0;
    }

    .about-page__experience > section + section {
      margin-top: 8px;
    }

    .about-page__expertise {
      columns: 1;
    }
  }


  /* Timeline teaser: the whole grey box is the link. */
  .about-page__timeline-link {
    margin-top: 16px; /* + 24px below Startups & Advisory */
    padding: 16px 20px;
    display: inline-flex; /* only as wide as its content */
    max-width: 100%;
    align-items: center;
    gap: 16px;
    border-radius: var(--radius-4);
    background: var(--background-page); /* same as the UX Freiburg channel boxes */
    color: var(--foreground-regular);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .about-page__timeline-here {
    color: var(--foreground-strong);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    transition: color 0.2s ease;
  }

  .about-page__timeline-arrow {
    width: 24px;
    height: 24px;
    flex: none;
    color: var(--foreground-light);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .about-page__timeline-arrow :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .about-page__timeline-link:hover .about-page__timeline-here,
  .about-page__timeline-link:focus-visible .about-page__timeline-here,
  .about-page__timeline-link:hover .about-page__timeline-arrow,
  .about-page__timeline-link:focus-visible .about-page__timeline-arrow {
    color: var(--foreground-link-hover);
  }

  .about-page__timeline-link:hover .about-page__timeline-arrow {
    transform: translateX(4px);
  }
</style>
