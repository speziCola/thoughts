---
import Card from "../components/Card.astro";
import SectionTitle from "../components/SectionTitle.astro";
import BlogLayout from "../layouts/BlogLayout.astro";

const base = import.meta.env.BASE_URL;
const canonical = "https://chriskuhrt.de/thoughts/about/";
---

<BlogLayout
  title="About"
  description="Designer, Product Strategist, DesignOps and UX Educator. I build the systems and structures that help teams deliver great product experiences."
  canonical={canonical}
>
  <section class="about-page" aria-labelledby="about-title">
    <SectionTitle as="h1" id="about-title">About</SectionTitle>

    <Card as="div" width="full">
      <section class="about-page__intro" aria-labelledby="about-intro-title">
        <div class="about-page__intro-copy">
          <h2 class="page-heading-level-3" id="about-intro-title">
            Hi, my name is Chris Kuhrt
          </h2>
          <p class="about-page__subtitle page-body-default">
            Designer, Product Strategist, DesignOps and UX Educator.
          </p>
          <p class="page-body-default">
            With over 10 years of experience across finance, marketplaces and
            digital platforms, my focus has evolved from crafting interfaces
            to building the systems behind them. I care about user-centered
            design, but even more about the structures that allow teams to
            deliver great design consistently.
          </p>
          <p class="page-body-default">
            My work focuses on building the structures that enable teams to
            deliver great product experiences. I work on improving
            collaboration between design, development, and management to ensure
            better outcomes, not just better outputs. I build design
            infrastructure that helps teams scale sustainably by aligning
            product, design and engineering through shared standards, clearer
            workflows and scalable systems. In my experience, great design is
            rarely a craft problem. It is usually a systems problem.
          </p>
          <p class="page-body-default">
            I’m driven by problem-solving, knowledge sharing and process
            optimization. Most of all, I care about improving how teams work
            together, creating clarity in complex environments and enabling UX
            to become a shared capability, not just a role.
          </p>
        </div>
        <img
          class="about-page__portrait"
          src={`${base}images/about-portrait.jpg`}
          alt="Portrait of Chris Kuhrt"
          width="512"
          height="512"
          loading="eager"
        />
      </section>

      <hr class="about-page__divider" />

      <section
        class="about-page__section about-page__experience-section"
        aria-labelledby="experience-title"
      >
        <h2 class="page-heading-level-2" id="experience-title">Experience</h2>
        <div class="about-page__experience">
          <section aria-labelledby="professional-experience-title">
            <h3 class="page-heading-level-4" id="professional-experience-title">
              Professional Experience
            </h3>
            <ul class="page-body-default about-page__professional-list">
              <li>Etops</li>
              <li>Patronas</li>
              <li>Chrono24</li>
              <li>Reservix</li>
            </ul>
            <section
              class="about-page__advisory"
              aria-labelledby="startup-experience-title"
            >
              <h3 class="page-heading-level-4" id="startup-experience-title">
                Startups &amp; advisory
              </h3>
              <ul class="page-body-default">
                <li>Betterahead</li>
                <li>Hammertime</li>
                <li>Biorenewables</li>
                <li>Geospin</li>
              </ul>
            </section>
          </section>
          <section aria-labelledby="client-experience-title">
            <h3 class="page-heading-level-4" id="client-experience-title">
              Client &amp; Project Experience
            </h3>
            <ul class="page-body-default">
              <li>DFB</li>
              <li>SC Freiburg</li>
              <li>Disney</li>
              <li>Swisscom</li>
              <li>hr</li>
              <li>Die Rheinpfalz</li>
            </ul>
          </section>
        </div>
        <p class="page-body-default">
          You can check out my timeline in detail <a href={`${base}timeline/`}>here</a>.
        </p>
      </section>

      <hr class="about-page__divider" />

      <p class="page-body-default about-page__statement">
        From design systems to organizational design. I align teams, tools,
        and strategy to ship better products.
      </p>

      <div class="about-page__details">
        <section class="about-page__section" aria-labelledby="expertise-title">
          <h2 class="page-heading-level-2" id="expertise-title">
            Areas of expertise
          </h2>
          <ul class="page-body-default about-page__expertise">
            <li>B2B, B2C, SaaS, etc.</li>
            <li>Human-centered (HCD) and customer-focused (CX) solutions</li>
            <li>Product design</li>
            <li>Design system</li>
            <li>
              User-centered organizational transformation and design maturity
            </li>
            <li>Strategic planning</li>
            <li>
              Agile methodologies focused on outcomes, Lean UX, and design
              thinking
            </li>
            <li>
              Efficient stakeholder management, both internal and external
            </li>
            <li>
              User research incorporating both qualitative and quantitative
              methods
            </li>
            <li>
              Identifying and prioritizing opportunities and framing problems
            </li>
            <li>Information architecture and interaction design</li>
            <li>Compliance with standards for usability and accessibility</li>
          </ul>
        </section>

        <section class="about-page__section" aria-labelledby="industries-title">
          <h2 class="page-heading-level-2" id="industries-title">Industries</h2>
          <ul class="page-body-default">
            <li>Finance</li>
            <li>E-Commerce</li>
            <li>Big Data</li>
          </ul>
        </section>
      </div>

      <section class="about-page__contact" aria-label="Contact">
        <a
          class="page-action-button about-page__button"
          href="mailto:chris+hello@qrt.de"
        >
          Get in touch
        </a>
      </section>
    </Card>
  </section>
</BlogLayout>

<style>
  .about-page__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(180px, 320px);
    align-items: start;
    gap: clamp(32px, 5vw, 72px);
  }

  .about-page__intro-copy h2,
  .about-page__section h2 {
    margin: 0 0 8px;
    color: var(--foreground-strong);
  }

  .about-page__intro-copy p,
  .about-page__section > p,
  .about-page__statement {
    max-width: 800px;
    margin: 0 0 24px;
    color: var(--foreground-regular);
  }

  .about-page__intro-copy .about-page__subtitle {
    margin-bottom: 32px;
    color: var(--foreground-strong);
  }

  .about-page__portrait {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: 50% 50% 0 50%;
    object-fit: cover;
  }

  .about-page__section {
    margin-top: clamp(48px, 6vw, 80px);
  }

  .about-page__divider {
    height: 1px;
    margin: clamp(40px, 5vw, 64px) 0;
    border: 0;
    background: var(--border-subtle);
  }

  .about-page__experience-section,
  .about-page__details .about-page__section {
    min-width: 0;
    margin-top: 0;
  }

  .about-page__experience {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: clamp(24px, 4vw, 48px);
  }

  .about-page__experience h3 {
    margin: 0 0 8px;
    color: var(--foreground-regular);
  }

  .about-page__section ul {
    margin: 0;
    padding-left: 24px;
    color: var(--foreground-regular);
  }

  .about-page__experience .about-page__professional-list {
    padding: 0;
    display: grid;
    gap: 4px;
    list-style: none;
    margin-bottom: 24px;
  }

  .about-page__professional-list li {
    padding: 8px 12px;
    border-radius: var(--radius-4);
    background: var(--background-page);
  }

  .about-page__advisory {
    margin-bottom: 24px;
  }

  .about-page__statement {
    margin: 0;
    color: var(--foreground-strong);
    font-weight: var(--page-weight-regular);
  }

  .about-page__details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px;
    margin-top: 32px;
  }

  .about-page__expertise {
    column-gap: 40px;
  }

  .about-page__expertise li {
    break-inside: avoid;
    padding-bottom: 8px;
  }

  .about-page__contact {
    margin-top: clamp(32px, 4vw, 56px);
  }

  .about-page__button {
    min-height: 48px;
    padding: 9px 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--foreground-strong);
    border-radius: var(--radius-4);
    color: var(--foreground-inverse);
    background: var(--foreground-strong);
    text-decoration: none;
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }

  .about-page__button:hover {
    color: var(--foreground-strong);
    background: transparent;
  }

  .about-page__button:focus-visible {
    outline-offset: 4px;
  }

  @media (max-width: 700px) {
    .about-page__intro {
      grid-template-columns: 1fr;
    }

    .about-page__portrait {
      width: 144px;
      justify-self: end;
      grid-row: 1;
    }

    .about-page__experience,
    .about-page__details {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .about-page__details .about-page__section {
      min-width: 0;
    }

    .about-page__experience > section + section {
      margin-top: 8px;
    }

    .about-page__expertise {
      columns: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-page__button {
      transition: none;
    }
  }
</style>
