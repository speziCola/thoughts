---
/**
 * Imprint (English).
 * Uses the blog article styles (.blog-article) so it reads like an article.
 */
import BlogLayout from "../layouts/BlogLayout.astro";
import { canonicalUrl } from "../lib/site";

const canonical = canonicalUrl("/imprint/");
---

<BlogLayout
  title="Imprint"
  description="Imprint and legal information for chriskuhrt.de: contact, copyright, liability, external links and image credits."
  canonical={canonical}
  layout="split"
  breadcrumbs={[
    { name: "Home", url: canonicalUrl("/home/") },
    { name: "Imprint", url: canonical },
  ]}
>
  <article class="blog-article">
    <h1>Imprint</h1>

    <section aria-label="Imprint">
      <p>
        Christopher Kuhrt<br />
        Email: christopher(at)qrt.de
      </p>

      <h2>Copyright</h2>
      <p>
        The content and works published on this website, in particular texts, photographs, graphics,
        illustrations and designs, are subject to German copyright law insofar as they are protected
        by copyright.
      </p>
      <p>
        Any use beyond the statutory limits of copyright law requires the prior consent of the
        respective rights holder. This applies in particular to reproduction, adaptation, distribution
        and making content publicly available.
      </p>
      <p>
        Where third-party content is used, the rights of the respective authors and rights holders are
        respected. Required source and author credits are marked accordingly.
      </p>
      <p>
        If you notice a possible copyright infringement on this website, please let me know. I will
        review justified notices and remove the content concerned where appropriate.
      </p>

      <h2>Liability for content</h2>
      <p>
        The content of this website has been created with care and presents my professional
        experience, projects and personal views.
      </p>
      <p>
        I strive to keep the information provided accurate and up to date. However, I cannot guarantee
        that it is complete, correct and current at all times.
      </p>
      <p>Statutory liability provisions remain unaffected.</p>

      <h2>External links</h2>
      <p>
        This website may contain links to external third-party websites whose content and design I
        have no influence over.
      </p>
      <p>The respective providers or operators are responsible for the content of linked websites.</p>
      <p>
        If I become aware of unlawful content on a linked website, I will review the link and remove
        it where appropriate.
      </p>

      <h2>Privacy</h2>
      <p>
        Information about how personal data is processed when you visit this website can be found in
        my separate privacy policy.
      </p>

      <h2>Image credits</h2>
      <p>
        Unless stated otherwise, the photographs, graphics and designs published on this website were
        created by me or are used with the appropriate permission.
      </p>
      <p>
        Credits for third-party content are given, where required, directly with the content or in
        another suitable place on the website.
      </p>
    </section>

  </article>
</BlogLayout>
