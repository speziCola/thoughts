---
import { getCollection, render } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { toPost } from "../../lib/posts";
import { canonicalUrl, PERSON_ID } from "../../lib/site";
import { getImage } from "astro:assets";

export async function getStaticPaths() {
  const posts = await getCollection(
    "thoughts",
    ({ data }) => import.meta.env.DEV || !data.draft,
  );

  return Promise.all(
    posts.map(async (entry) => {
      const { Content } = await render(entry);
      const post = toPost(entry);
      return {
        params: { slug: post.slug },
        props: { post, Content },
      };
    }),
  );
}

const { post, Content } = Astro.props;

const canonical = canonicalUrl(`/thoughts/${post.slug}/`);
const date = post.date.toISOString().slice(0, 10);
const formattedDate = post.date.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});

const wordCount = (post.entry.body ?? "").split(/\s+/).filter(Boolean).length;
const cover = post.coverImage
  ? await getImage({ src: post.coverImage, width: Math.min(1200, post.coverImage.width), format: "jpg" })
  : undefined;

const blogPosting = {
  "@type": "BlogPosting",
  "@id": `${canonical}#article`,
  mainEntityOfPage: { "@id": `${canonical}#webpage` },
  isPartOf: { "@id": canonicalUrl("/thoughts/#blog") },
  headline: post.seoTitle,
  description: post.description,
  url: canonical,
  datePublished: post.date.toISOString(),
  dateModified: (post.updated ?? post.date).toISOString(),
  author: { "@id": PERSON_ID },
  publisher: { "@id": PERSON_ID },
  inLanguage: "en",
  wordCount,
  ...(post.tags.length ? { keywords: post.tags.join(", ") } : {}),
  ...(cover ? { image: new URL(cover.src, canonicalUrl("/")).href } : {}),
};
---

<BlogLayout
  title={post.seoTitle}
  description={post.description}
  canonical={canonical}
  layout="split"
  ogType="article"
  image={post.coverImage}
  imageAlt={post.coverAlt}
  published={post.date}
  modified={post.updated}
  tags={post.tags}
  breadcrumbs={[
    { name: "Home", url: canonicalUrl("/home/") },
    { name: "Thoughts", url: canonicalUrl("/thoughts/") },
    { name: post.seoTitle, url: canonical },
  ]}
  jsonLd={[blogPosting]}
>
  <article class="blog-article">
    <time class="post-date" datetime={date}>{formattedDate}</time>
    <Content />
  </article>
</BlogLayout>
