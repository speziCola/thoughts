---
import ArticleTeaser from "../../components/ArticleTeaser.astro";
import CardGrid from "../../components/CardGrid.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { url } from "../../lib/url";
import { getPosts } from "../../lib/posts";
import { canonicalUrl, PERSON_ID } from "../../lib/site";

const canonical = canonicalUrl("/thoughts/");
const articles = await getPosts();

const blog = {
  "@type": "Blog",
  "@id": `${canonical}#blog`,
  url: canonical,
  name: "Thoughts by Chris Kuhrt",
  description: "Articles by Chris Kuhrt about design leadership, UX, design systems, research and AI prototyping.",
  inLanguage: "en",
  author: { "@id": PERSON_ID },
  publisher: { "@id": PERSON_ID },
  blogPost: articles.map((a) => ({
    "@type": "BlogPosting",
    "@id": canonicalUrl(`/thoughts/${a.slug}/#article`),
    headline: a.seoTitle,
    url: canonicalUrl(`/thoughts/${a.slug}/`),
    datePublished: a.date.toISOString(),
  })),
};
---

<BlogLayout
  title="Sharing Thoughts"
  fullTitle="Thoughts: Design Leadership, UX & Design Systems – Chris Kuhrt"
  description="Articles by Chris Kuhrt on design leadership, UX maturity, design systems, research methods, effective workshops and AI prototyping."
  canonical={canonical}
  breadcrumbs={[
    { name: "Home", url: canonicalUrl("/home/") },
    { name: "Thoughts", url: canonical },
  ]}
  jsonLd={[blog]}
  layout="split"
>
  <section aria-labelledby="overview-title">
    <SectionTitle as="h1" id="overview-title">Sharing Thoughts</SectionTitle>

    <CardGrid columns={1}>
      {
        articles.map((article, index) => (
          <ArticleTeaser
            layout="split"
            title={article.title}
            href={url(`/thoughts/${article.slug}/`)}
            description={article.description}
            date={article.date}
            image={article.coverImage}
            alt={article.coverAlt}
            tags={article.tags}
            eager={index === 0}
          />
        ))
      }
    </CardGrid>
  </section>
</BlogLayout>
