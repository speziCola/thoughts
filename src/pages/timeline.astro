---
import Card from "../components/Card.astro";
import FloatingMenu from "../components/FloatingMenu.astro";
import SectionTitle from "../components/SectionTitle.astro";
import BlogLayout from "../layouts/BlogLayout.astro";
import { Image } from "astro:assets";
import { timelineSections } from "../data/timeline";
import arrowNarrowRight from "../assets/icons/arrow-narrow-right.svg?raw";
import etopsLogo from "../assets/images/etops-logo.png";
import patronasLogo from "../assets/images/patronas-logo.png";
import chrono24Logo from "../assets/images/chrono24-logo.png";
import reservixLogo from "../assets/images/reservix-logo.png";

const logos = {
  etops: etopsLogo,
  patronas: patronasLogo,
  chrono24: chrono24Logo,
  reservix: reservixLogo,
};

const roleArrow = arrowNarrowRight
  .replace(/stroke="black"/g, 'stroke="currentColor"')
  .replace(/<svg /, '<svg class="timeline-entry__role-chevron" role="img" aria-label="to" ');
// Outline icons (24×24, 2px stroke), inlined so they follow the text colour (green on hover).
import workExperience from "../assets/icons/work-experience.svg?raw";
import passionProjects from "../assets/icons/passion-projects.svg?raw";
import freelancer from "../assets/icons/freelancer.svg?raw";
import furtherEducation from "../assets/icons/further-education.svg?raw";
import volunteerWork from "../assets/icons/volunteer-work.svg?raw";
import backer from "../assets/icons/backer.svg?raw";
import gaming from "../assets/icons/gaming.svg?raw";

const iconSvgs: Record<string, string> = {
  "work-experience": workExperience,
  "passion-projects": passionProjects,
  freelancer,
  "further-education": furtherEducation,
  "volunteer-work": volunteerWork,
  backer,
  gaming,
};

/** Split a description into text and [text](url) link parts. */
const linkPattern = /\[([^\]]+)\]\(([^)\s]+)\)/g;
const descriptionParts = (text: string) => {
  const parts: { text: string; href?: string }[] = [];
  let last = 0;
  for (const match of text.matchAll(linkPattern)) {
    if (match.index! > last) parts.push({ text: text.slice(last, match.index) });
    parts.push({ text: match[1], href: match[2] });
    last = match.index! + match[0].length;
  }
  if (last < text.length) parts.push({ text: text.slice(last) });
  return parts;
};

const sections = timelineSections.map((section) => {
  const svg = iconSvgs[section.id];
  if (!svg) throw new Error(`No timeline icon for section "${section.id}".`);
  return {
    ...section,
    icon: svg
      .replace(/stroke="black"/g, 'stroke="currentColor"')
      .replace(/ width="24" height="24"/, ' focusable="false"'),
  };
});

const canonical = "https://chriskuhrt.de/timeline/";
---

<BlogLayout
  title="Timeline"
  fullTitle="Timeline: Career & Projects of Chris Kuhrt"
  breadcrumbs={[
    { name: "Home", url: "https://chriskuhrt.de/home/" },
    { name: "Timeline", url: canonical },
  ]}
  description="Work experience, projects, freelance work, further education, volunteer work and more – the full timeline of Chris Kuhrt."
  canonical={canonical}
  layout="split"
>
  <div class="timeline">
    <header class="timeline__header">
      <SectionTitle as="h1">Timeline</SectionTitle>
      <p class="page-body timeline__intro">
        I am filled with gratitude for every experience. Each one has helped
        shape who I am today as a designer and leader, and I look forward to
        the next chapter of this ever-evolving journey.
      </p>
    </header>

    <div class="timeline__layout">
      <!-- Desktop: sticky jump navigation beside the sections. -->
      <nav class="timeline__aside" aria-label="Timeline sections">
        <Card as="div" padding="sm" class="timeline__nav-card">
          <ul class="timeline__nav-list" data-timeline-nav>
            {
              sections.map((section) => (
                <li>
                  <a class="timeline__nav-link" href={`#${section.id}`}>
                    <span class="timeline__nav-icon" aria-hidden="true" set:html={section.icon} />
                    <span class="timeline__nav-label">{section.title}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </Card>
      </nav>

      <div class="timeline__sections">
        {
          sections.map((section) => (
            <Card
              as="section"
              padding="lg"
              class:list={["timeline-section", { "timeline-section--logos": section.entries.some((entry) => entry.logo) }]}
              id={section.id}
              aria-labelledby={`${section.id}-title`}
              data-timeline-section
            >
              <h2 class="page-title-lg timeline-section__title" id={`${section.id}-title`}>
                <span class="timeline-section__icon" aria-hidden="true" set:html={section.icon} />
                {section.title}
              </h2>

              <ol class="timeline-section__entries">
                {section.entries.map((entry) => (
                  <li class="timeline-entry">
                    {entry.logo && (
                      <Image
                        class="timeline-entry__logo"
                        src={logos[entry.logo]}
                        alt=""
                        width={32}
                        height={32}
                        densities={[1, 2]}
                      />
                    )}
                    <p class="timeline-entry__date">{entry.date}</p>
                    <h3 class="page-title-md timeline-entry__organisation">
                      {entry.href ? <a href={entry.href}>{entry.organisation}</a> : entry.organisation}
                    </h3>
                    <p class="page-small timeline-entry__role">
                      {entry.role.split(/\s*→\s*/).map((step, i) => (
                        <>
                          {i > 0 && <Fragment set:html={roleArrow} />}
                          {step}
                        </>
                      ))}
                    </p>
                    <p class="page-body timeline-entry__description">
                      {descriptionParts(entry.description).map((part) =>
                        part.href ? <a href={part.href}>{part.text}</a> : part.text,
                      )}
                    </p>
                    {entry.highlights && (
                      <ul class="page-body timeline-entry__highlights">
                        {entry.highlights.map((item) => (
                          <li>
                            {item.label && <strong>{item.label}:</strong>} {item.text}
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ol>
            </Card>
          ))
        }
      </div>
    </div>

    <!-- Mobile: floating "Timeline" pill (left) next to the main "Menu" pill.
         Tablet/small laptop (side nav hidden, >900px): the same pill, 300px wide,
         sticky at the bottom of the content column. -->
    <FloatingMenu label="Timeline" navLabel="Timeline sections" icon="chevron" side="left" stretch class="timeline-menu">
      <ul data-timeline-nav>
        {
          sections.map((section) => (
            <li>
              <a href={`#${section.id}`}>
                <span class="timeline__menu-icon" aria-hidden="true" set:html={section.icon} />
                <span class="floating-menu__text">{section.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </FloatingMenu>
  </div>
</BlogLayout>

<script>
  // Progressive enhancement: highlight the section currently in view.
  const sections = document.querySelectorAll<HTMLElement>("[data-timeline-section]");
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-timeline-nav] a");

  const setActive = (id: string) => {
    links.forEach((link) => {
      if (link.hash === `#${id}`) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });
  };

  // The first section ("Work Experience") starts right under the page intro,
  // so its links scroll to the very top instead: title and intro stay visible.
  const firstId = sections[0]?.id;
  links.forEach((link) => {
    if (!firstId || link.hash !== `#${firstId}`) return;
    link.addEventListener("click", (event) => {
      event.preventDefault();
      window.scrollTo({ top: 0 }); // smooth via html { scroll-behavior }, off for reduced motion
      history.replaceState(null, "", `#${firstId}`);
      setActive(firstId);
    });
  });
  // Same when the page is opened with that anchor (e.g. a shared link).
  // Runs after load, once the browser has done its own jump to the anchor.
  if (firstId && location.hash === `#${firstId}`) {
    const toTop = () => requestAnimationFrame(() => window.scrollTo({ top: 0, behavior: "instant" }));
    if (document.readyState === "complete") toTop();
    else window.addEventListener("load", toTop, { once: true });
  }

  if ("IntersectionObserver" in window && sections.length) {
    const visible = new Map<string, boolean>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => visible.set(entry.target.id, entry.isIntersecting));
        const current = [...sections].find((section) => visible.get(section.id));
        if (current) setActive(current.id);
      },
      // A thin band just below the sticky header decides the active section.
      { rootMargin: "-120px 0px -70% 0px" },
    );
    sections.forEach((section) => observer.observe(section));
  }

</script>

<style>
  .timeline {
    /* Sticky header = 16px offset + 64px bar (desktop); 20 + 64 + 20 (mobile). */
    --timeline-sticky-top: 96px;
    --timeline-scroll-offset: var(--timeline-sticky-top);
  }

  .timeline :is(h2, h3, p) {
    margin: 0;
  }

  .timeline__intro {
    max-width: 640px;
    color: var(--foreground-regular);
  }

  .timeline__layout {
    margin-top: clamp(24px, 3vw, 40px);
    display: grid;
    grid-template-columns: minmax(220px, 312px) minmax(0, 1fr);
    align-items: start;
    gap: 16px;
  }

  /* Sticky jump navigation */
  .timeline__aside {
    position: sticky;
    top: var(--timeline-sticky-top);
  }

  .timeline__nav-card :global(.card__content) {
    gap: 0;
  }

  .timeline__nav-list {
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
    list-style: none;
  }

  .timeline__nav-link {
    padding: 6px 8px;
    display: flex;
    align-items: center;
    gap: 12px;
    border-radius: var(--radius-4);
    color: var(--foreground-strong);
    font-family: var(--page-font-title);
    font-size: var(--page-body-size);
    font-weight: var(--page-weight-semibold);
    line-height: var(--page-body-line-height);
    text-decoration: none;
  }

  .timeline__nav-label {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .timeline__nav-link:hover,
  .timeline__nav-link[aria-current] {
    color: var(--foreground-link-hover);
  }

  .timeline__nav-icon,
  .timeline__menu-icon {
    width: 20px;
    height: 20px;
    flex: none;
    display: block;
  }

  /* Sections */
  .timeline__sections {
    display: grid;
    gap: 16px;
  }

  .timeline-section {
    scroll-margin-top: var(--timeline-scroll-offset);
  }

  .timeline-section :global(.card__content) {
    gap: 32px;
  }

  .timeline-section__title {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--foreground-regular);
  }

  .timeline-section__icon {
    width: 0.9em;
    height: 0.9em;
    flex: none;
    color: var(--foreground-regular); /* same as the section title */
    display: block;
  }

  .timeline__nav-icon :global(svg),
  .timeline__menu-icon :global(svg),
  .timeline-section__icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .timeline-section__entries {
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(24px, 2.5vw, 32px);
    list-style: none;
  }

  .timeline-entry {
    position: relative;
    display: grid;
    gap: 2px;
  }

  /* Sections with company logos: every entry gets the logo column, so text stays aligned. */
  :global(.timeline-section--logos) .timeline-entry {
    padding-left: 48px;
  }

  .timeline-entry__logo {
    position: absolute;
    top: 2px;
    left: 0;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-4);
  }

  .timeline-entry__date {
    color: var(--foreground-light);
    font-family: var(--page-font-title);
    font-size: var(--page-small-size);
    font-weight: var(--page-weight-semibold);
    line-height: var(--page-lineheight-normal);
  }

  .timeline-entry__organisation {
    color: var(--foreground-strong);
  }

  .timeline-entry__organisation a {
    color: inherit;
    text-underline-offset: 0.15em;
  }

  .timeline-entry__description a {
    color: var(--foreground-strong);
    text-underline-offset: 0.15em;
  }

  .timeline-entry__description a:hover {
    color: var(--foreground-link-hover);
  }

  .timeline-entry__organisation a:hover {
    color: var(--foreground-link-hover);
  }

  /* "Product Designer → Design System Lead": the arrow in the data renders as arrow-narrow-right. */
  .timeline-entry__role :global(.timeline-entry__role-chevron) {
    display: inline-block;
    width: 1em;
    height: 1em;
    margin: 0 0.25em;
    vertical-align: -0.15em;
  }

  .timeline-entry__role {
    margin-bottom: 8px;
    color: var(--foreground-strong);
  }

  .timeline-entry__description,
  .timeline-entry__highlights {
    max-width: 800px;
    color: var(--foreground-regular);
  }

  .timeline-entry__highlights {
    margin: 8px 0 0;
    padding-left: 21px;
    display: grid;
    gap: 4px;
    list-style: disc;
  }

  .timeline-entry__highlights strong {
    color: var(--foreground-strong);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .timeline {
      --timeline-scroll-offset: 100px;
    }
  }

  @container page (max-width: 867px) {
    .timeline__layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .timeline__aside {
      display: none;
    }
  }

  /* Between 900px and the width where the side nav returns there is no main
     Menu pill, so the Timeline pill shows alone. Sticky (not fixed) keeps it in
     the content column, next to the art panel, and lets it stop before the footer. */
  @media (min-width: 901px) {
    @container page (max-width: 867px) {
      .timeline :global(.timeline-menu) {
        position: sticky;
        z-index: 5; /* above the cards, below the sticky site header (10) */
        bottom: 24px;
        width: 300px;
        margin-top: 40px;
        display: block;
      }
    }
  }

</style>
