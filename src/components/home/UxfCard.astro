---
/**
 * UX Freiburg community card: text, channel stats and photo gallery.
 * Used on the start page and on What I Do.
 */
import { Image } from "astro:assets";
import HomeCard from "./HomeCard.astro";
import "../../styles/home-shared.css";
import uxfRooftop from "../../assets/images/community-1.png";
import uxfSpeaker from "../../assets/images/community-2.png";
import uxfChallenges from "../../assets/images/community-3.png";
import uxfAgenda from "../../assets/images/community-4.png";
// Raw SVG, inlined so the icons can take currentColor (green on hover).
import channelLinkedin from "../../assets/icons/channel-linkedin.svg?raw";
import channelMeetup from "../../assets/icons/channel-meetup.svg?raw";
import channelDiscord from "../../assets/icons/channel-discord.svg?raw";

interface Props {
  /** Heading level of the card title. */
  headingLevel?: 2 | 3;
}

const { headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
const href = "https://uxfreiburg.framer.website/";

/* Icons are centred in a 32×32 box. Sizes are set by eye so the three marks
   carry the same visual weight: Meetup 24×24 as the reference, LinkedIn smaller
   because its solid letters look heavier, Discord a little wider than Meetup
   so its flat shape matches it in mass (height follows its proportions). */
/** Inline SVG at the given width; height follows the viewBox, colour follows currentColor. */
const icon = (svg: string, width: number) => {
  const [, , vbWidth, vbHeight] = svg.match(/viewBox="([^"]+)"/)![1].split(/\s+/).map(Number);
  const height = Math.round((vbHeight / vbWidth) * width);
  return svg
    .replace(/<svg[^>]*?(viewBox="[^"]+")[^>]*>/, `<svg width="${width}" height="${height}" $1 fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">`)
    .replace(/fill="#656565"/g, 'fill="currentColor"');
};

/* Community channel links. */
const channels: { name: string; members: number; icon: string; href?: string }[] = [
  { name: "Meetup", members: 364, icon: icon(channelMeetup, 24), href: "https://www.meetup.com/ux-meetup-freiburg/" },
  { name: "LinkedIn", members: 219, icon: icon(channelLinkedin, 20), href: "https://www.linkedin.com/groups/12851280/" },
  { name: "Discord", members: 87, icon: icon(channelDiscord, 26), href: "https://join.uxfreiburg.de/" },
];
---

<HomeCard layout="split" mediaFirst gap={64} labelledby="uxf-title">
  <div>
    <Heading class="home-card-title" id="uxf-title">
      <a href={href}>UX Meetup &amp; German UPA regional group Freiburg</a>
    </Heading>
    <p class="home-text">
      <strong>UX Freiburg</strong> is the official German UPA regional group
      for Freiburg, co-founded to strengthen the local UX, Product and Tech
      community. Regular meetups create room for knowledge sharing and bring
      together designers, researchers, product managers and engineers across
      companies and industries.
    </p>
    <p class="home-text">
      Today, the community reaches <strong>600+ professionals</strong>, with
      members from companies such as Haufe, Lexware, JobRad, SICK and many
      others.
    </p>
    <a class="home-action uxf__visit" href={href}>Visit UX Freiburg</a>
    <ul class="channels" aria-label="Community members per channel">
      {
        channels.map(({ name, members, icon, href }) => {
          const Tag = href ? "a" : "div";
          return (
            <li>
              <Tag class="channels__item" href={href}>
                <span class="channels__icon" aria-hidden="true" set:html={icon} />
                <span class="channels__text">
                  <span class="channels__name">{name}</span>
                  <span class="channels__count">{members}</span>
                </span>
              </Tag>
            </li>
          );
        })
      }
    </ul>
  </div>

  <div class="uxf-gallery">
    <div class="uxf-gallery__row uxf-gallery__row--a">
      <Image src={uxfRooftop} quality={70} alt="UX Freiburg members chatting over food on a rooftop terrace" widths={[120, 200, 300, 400, 600]} sizes="(max-width: 900px) 32vw, (max-width: 1170px) 20vw, 10vw" />
      <Image class="uxf-gallery__speaker" src={uxfSpeaker} quality={70} alt="A speaker addressing the audience at a UX Freiburg meetup" widths={[200, 300, 400, 560, 720]} sizes="(max-width: 900px) 55vw, (max-width: 1170px) 35vw, 17vw" />
    </div>
    <div class="uxf-gallery__row uxf-gallery__row--b">
      <Image src={uxfChallenges} quality={70} alt="A speaker in front of a screen reading “UX, Team, Challenges, Learnings!”" widths={[100, 160, 240, 320, 480]} sizes="(max-width: 900px) 25vw, (max-width: 1170px) 16vw, 8vw" />
      <Image class="uxf-gallery__agenda" src={uxfAgenda} quality={70} alt="An audience watching a talk with an agenda slide at a UX Freiburg event" widths={[240, 320, 460, 640, 846]} sizes="(max-width: 900px) 62vw, (max-width: 1170px) 39vw, 19vw" />
    </div>
  </div>
</HomeCard>

<style>
  .home-text strong {
    color: var(--foreground-strong);
    font-weight: 600;
  }


  .uxf__visit {
    display: inline-block;
    margin-top: 24px;
  }

  .channels {
    margin: 40px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
  }

  .channels__icon {
    width: 32px;
    height: 32px;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .channels__icon :global(svg) {
    display: block;
    flex: none;
    color: var(--foreground-light);
    transition: color 0.2s ease;
  }

  .channels__item {
    padding: 16px 24px 16px 16px;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    border-radius: var(--radius-4);
    background: var(--background-page);
    box-shadow: var(--shadow-highlight);
  }

  .channels__text {
    display: flex;
    flex-direction: column;
  }

  a.channels__item {
    text-decoration: none;
  }

  /* Hover/focus: icon and name turn green, the member count stays as it is. */
  a.channels__item:hover .channels__icon :global(svg),
  a.channels__item:focus-visible .channels__icon :global(svg),
  a.channels__item:hover .channels__name,
  a.channels__item:focus-visible .channels__name {
    color: var(--foreground-link-hover);
  }

  .channels__name {
    color: var(--foreground-strong);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    transition: color 0.2s ease;
    font-family: var(--page-font-body);
    font-size: var(--page-small-size);
    line-height: var(--page-small-line-height);
  }

  .channels__count {
    color: var(--foreground-regular);
    font-family: var(--page-font-body);
    font-size: var(--page-label-size);
    line-height: var(--page-label-line-height);
  }

  .uxf-gallery {
    --uxf-gap: 16px;
    display: grid;
    gap: var(--uxf-gap);
  }

  .uxf-gallery__row {
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    min-height: 0; /* keep tall images from growing the row past its aspect ratio */
    gap: var(--uxf-gap);
  }

  .uxf-gallery__row--a {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.75fr);
    aspect-ratio: 1302 / 461;
  }

  .uxf-gallery__row--b {
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.5fr);
    aspect-ratio: 587 / 198;
  }

  /* Two columns: the gallery takes the height of the text column instead of
     its own aspect ratio, so the card is no taller than the text needs. */
  @container (min-width: 641px) {
    .uxf-gallery {
      contain: size; /* don't let the images' intrinsic height grow the row */
      align-self: stretch;
      grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
    }

    .uxf-gallery__row--a,
    .uxf-gallery__row--b {
      aspect-ratio: auto;
      min-height: 0;
    }
  }

  .uxf-gallery img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    border-radius: var(--radius-4);
  }

  /* Speaker photo: always crop from the top-right corner. */
  .uxf-gallery .uxf-gallery__speaker {
    object-position: right top;
  }

  /* Audience photo: always crop from the top-left corner. */
  .uxf-gallery .uxf-gallery__agenda {
    object-position: left top;
  }

  @media (max-width: 900px) {
    .channels {
      flex-direction: column;
    }

    .uxf-gallery {
      --uxf-gap: 8px;
    }
  }
</style>
