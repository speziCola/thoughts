---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  id: string;
  title: string;
  /** Optional: without it the header is just the title with its accent line. */
  icon?: ImageMetadata;
}

const { id, title, icon } = Astro.props;
---

<div class="section-header">
  {
    icon && (
      <span class="section-header__icon" aria-hidden="true">
        <Image src={icon} alt="" width={40} height={40} />
      </span>
    )
  }
  <h2 class="section-header__title" id={id}>{title}</h2>
</div>

<style>
  /* The 56px tile sets the header height (40px icon, 28px title) on desktop,
     scaling down to a 40px tile / 20px title on mobile (fluid 360–1920px). */
  .section-header {
    --section-tile: clamp(40px, calc(36.3077px + 1.0256vw), 56px);
    display: flex;
    gap: 12px;
    align-items: stretch;
  }

  .section-header__icon {
    width: var(--section-tile);
    height: var(--section-tile);
    display: grid;
    flex: none;
    place-items: center;
    border-radius: var(--radius-4);
    background: var(--background-inverse);
  }

  .section-header__icon img {
    display: block;
    width: calc(var(--section-tile) - 16px);
    height: calc(var(--section-tile) - 16px);
    filter: invert(1); /* icons are black; show them white on the black tile */
  }

  .section-header__title {
    position: relative;
    flex: 1;
    min-width: 0;
    margin: 0;
    padding-bottom: 10px;
    display: flex;
    align-items: center;
    color: var(--foreground-strong);
    font-family: var(--page-font-title);
    font-size: var(--page-title-section-size);
    font-weight: 700;
    line-height: 1.35;
  }

  /* 80×6 rounded accent line under the title. */
  .section-header__title::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 80px;
    height: 6px;
    border-radius: 999px;
    background: var(--border-title);
  }
</style>
