---
/**
 * Start page: the two newest articles ("Sharing Thoughts").
 * Picked automatically from the blog collection (same source and order as
 * /thoughts/), so the section updates with every new post.
 *
 * Uses the same stacked article teaser as "Enabling People" (cover, date,
 * title, description, "Read article"), two cards 50/50, one per row on
 * mobile (CardGrid). One card style for articles across the start page.
 */
import ArticleTeaser from "../ArticleTeaser.astro";
import CardGrid from "../CardGrid.astro";
import { getPosts } from "../../lib/posts";
import { url } from "../../lib/url";

const latest = (await getPosts()).slice(0, 2);
---

{
  latest.length > 0 && (
    <CardGrid columns={2} gap="md">
      {latest.map((post) => (
        <ArticleTeaser
          title={post.title}
          href={url(`/thoughts/${post.slug}/`)}
          description={post.description}
          date={post.date}
          image={post.coverImage}
          alt={post.coverAlt}
          headingLevel={3}
        />
      ))}
    </CardGrid>
  )
}
