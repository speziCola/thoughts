---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import HomeCard from "./HomeCard.astro";

interface Props {
  id: string;
  title: string;
  text: string;
  href: string;
  image: ImageMetadata;
  imageAlt: string;
}

const { id, title, text, href, image, imageAlt } = Astro.props;
---

<HomeCard labelledby={id}>
  <a class="teaser__media" href={href} tabindex="-1" aria-hidden="true">
    <Image src={image} alt={imageAlt} widths={[360, 720]} sizes="360px" />
  </a>
  <div class="teaser__content">
    <h3 class="home-card-title" id={id}><a href={href}>{title}</a></h3>
    <p class="home-text">{text}</p>
    <a class="home-action" href={href}>
      Read article<span class="visually-hidden">: {title}</span>
    </a>
  </div>
</HomeCard>

<style>
  .teaser__media {
    display: block;
    width: 100%;
    max-width: 360px;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    border: 0.667px solid #d9d9d9;
    border-radius: var(--radius-4);
    background: #fdfdfd;
  }

  .teaser__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .teaser__content .home-text {
    margin-bottom: 24px;
  }
</style>
