---
import FloatingMenu from "./FloatingMenu.astro";
import ThemeToggle from "./ThemeToggle.astro";
import AskLlm from "./AskLlm.astro";
import ckWordmarkRaw from "../assets/icons/ck.svg?raw";
import { url } from "../lib/url";

/** One menu for every page of the site. */
const homeHref = url("/");
// Inline so the wordmark uses the same colour token as the bubble mark (currentColor).
const ckWordmark = ckWordmarkRaw
  .replace(/fill="#191929"/g, 'fill="currentColor"')
  .replace(/<svg /, '<svg class="site-brand__wordmark" aria-hidden="true" ');
const currentPath = Astro.url.pathname.replace(/\/?$/, "/");

// Timeline is not in the menu; it is linked from About.
const navItems = [
  { label: "Home", href: homeHref },
  { label: "What I Do", href: url("/what-i-do/") },
  { label: "Sharing Thoughts", href: url("/thoughts/") },
  { label: "About", href: url("/about/") },
].map((item) => ({ ...item, current: item.href === currentPath }));
---

<header class="site-header">
  <div class="site-header__wrapper">
    <div class="site-header__inner">
      <a
        class="site-brand"
        href={homeHref}
        aria-label="Chris Kuhrt – start page"
        aria-current={currentPath === homeHref ? "page" : undefined}
      >
        <span class="site-brand__mark" aria-hidden="true"></span>
        <Fragment set:html={ckWordmark} />
      </a>
      <div class="site-header__actions">
        <nav class="site-nav" aria-label="Main navigation">
          {
            navItems.map((item) => (
              <a href={item.href} aria-current={item.current ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <AskLlm />
      </div>
    </div>
  </div>
</header>

<!-- Mobile (≤900px): the header links move into a floating "Menu" pill. -->
<FloatingMenu label="Menu" navLabel="Main navigation" panelWidth="318px">
  <ul>
    {
      navItems.map((item) => (
        <li>
          <a href={item.href} aria-current={item.current ? "page" : undefined}>
            <span class="floating-menu__text">{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <ThemeToggle slot="footer" variant="panel" />
</FloatingMenu>
