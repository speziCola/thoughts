---
import FloatingMenu from "./FloatingMenu.astro";
import ckWordmark from "../assets/icons/ck.svg";

/** One menu for every page of the site. */
const base = import.meta.env.BASE_URL;
const homeHref = `${base}home/`;
const currentPath = Astro.url.pathname;

const navItems = [
  { label: "What I Do", href: `${base}what-i-do/` },
  { label: "Sharing Thoughts", href: `${base.replace(/\/$/, "")}/` },
  { label: "Timeline", href: `${base}timeline/` },
  { label: "About", href: `${base}about/` },
].map((item) => ({ ...item, current: item.href === currentPath }));
---

<header class="site-header">
  <div class="site-header__wrapper">
    <div class="site-header__inner">
      <a
        class="site-brand"
        href={homeHref}
        aria-label="Christopher Kuhrt – start page"
        aria-current={currentPath === homeHref ? "page" : undefined}
      >
        <span class="site-brand__mark" aria-hidden="true"></span>
        <img
          class="site-brand__wordmark"
          src={ckWordmark.src}
          alt=""
        />
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        {
          navItems.map((item) => (
            <a href={item.href} aria-current={item.current ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>

<!-- Mobile (≤900px): the header links move into a floating "Menu" pill. -->
<FloatingMenu label="Menu" navLabel="Main navigation" panelWidth="318px">
  <ul>
    <li>
      <a href={homeHref} aria-current={currentPath === homeHref ? "page" : undefined}>
        <span class="floating-menu__text">Home</span>
      </a>
    </li>
    {
      navItems.map((item) => (
        <li>
          <a href={item.href} aria-current={item.current ? "page" : undefined}>
            <span class="floating-menu__text">{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</FloatingMenu>
