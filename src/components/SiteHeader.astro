---
export interface NavItem {
  label: string;
  href: string;
}

interface Props {
  /** Main navigation. Defaults to the blog's single "Sharing Thoughts" link. */
  nav?: NavItem[];
}

const base = import.meta.env.BASE_URL;
const homeHref = `${base.replace(/\/$/, "")}/`;
const { nav = [{ label: "Sharing Thoughts", href: homeHref }] } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="site-header__wrapper">
    <div class="site-header__inner">
      <a
        class="site-brand"
        href="https://chriskuhrt.de"
        aria-label="Christopher Kuhrt"
      >
        <span class="site-brand__mark" aria-hidden="true"></span>
        <img
          class="site-brand__wordmark"
          src={`${base}images/ck.svg`}
          alt=""
        />
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        {
          nav.map(({ label, href }) => (
            <a
              href={href}
              aria-current={href === currentPath ? "page" : undefined}
            >
              {label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>
