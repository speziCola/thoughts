---
import FloatingMenu from "./FloatingMenu.astro";

const base = import.meta.env.BASE_URL;
const homeHref = `${base.replace(/\/$/, "")}/`;
const whatIDoHref = `${base}what-i-do/`;
const aboutHref = `${base}about/`;
const isOverview = Astro.url.pathname === homeHref;
const isWhatIDo = Astro.url.pathname === whatIDoHref;
const isAbout = Astro.url.pathname === aboutHref;

const navItems = [
  { label: "What I Do", href: whatIDoHref, current: isWhatIDo },
  { label: "Sharing Thoughts", href: homeHref, current: isOverview },
  { label: "About", href: aboutHref, current: isAbout },
];
---

<header class="site-header">
  <div class="site-header__wrapper">
    <div class="site-header__inner">
      <a
        class="site-brand"
        href="https://chriskuhrt.de"
        aria-label="Christopher Kuhrt"
      >
        <span class="site-brand__mark" aria-hidden="true"></span>
        <img
          class="site-brand__wordmark"
          src={`${base}images/ck.svg`}
          alt=""
        />
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        <a href={whatIDoHref} aria-current={isWhatIDo ? "page" : undefined}>
          What I Do
        </a>
        <a href={homeHref} aria-current={isOverview ? "page" : undefined}>
          Sharing Thoughts
        </a>
        <a href={aboutHref} aria-current={isAbout ? "page" : undefined}>
          About
        </a>
      </nav>
    </div>
  </div>
</header>

<!-- Mobile (≤900px): the header links move into a floating "Menu" pill. -->
<FloatingMenu label="Menu" navLabel="Main navigation" panelWidth="318px">
  <ul>
    <li><a href="https://chriskuhrt.de"><span class="floating-menu__text">Home</span></a></li>
    {
      navItems.map((item) => (
        <li>
          <a href={item.href} aria-current={item.current ? "page" : undefined}>
            <span class="floating-menu__text">{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</FloatingMenu>
