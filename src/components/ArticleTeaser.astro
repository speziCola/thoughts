---
/**
 * Article teaser card: title, description, "Read article" link and cover.
 *
 * - layout "split" (overview list): content left, 16:9 cover right, optional
 *   date and tags.
 * - layout "stack" (What I Do): 2:1 cover (max 360px) above the content.
 *
 * The cover link repeats the title link, so it is removed from the tab order
 * and accessibility tree: one focus stop and one announced link per teaser.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Card from "./Card.astro";

interface Props {
  title: string;
  href: string;
  description: string;
  image?: ImageMetadata;
  alt?: string;
  date?: Date;
  tags?: string[];
  layout?: "stack" | "split";
  width?: "full" | "half";
  headingLevel?: 2 | 3;
  eager?: boolean;
}

const {
  title,
  href,
  description,
  image,
  alt = "",
  date,
  tags = [],
  layout = "stack",
  width = layout === "split" ? "full" : "half",
  headingLevel = 2,
  eager = false,
} = Astro.props;

const Heading = `h${headingLevel}` as "h2" | "h3";
const isSplit = layout === "split";
const imageWidths = isSplit
  ? [480, 800, 1200, 1440, image?.width ?? 1440].filter((w, i, all) => all.indexOf(w) === i)
  : [360, 720];
/*
 * Split teasers sit next to the art panel (see .split-page / Card.astro):
 * - ≤900px: full card width (page gutter 16 + card padding 24 per side)
 * - 901–1330px: card stacks, cover = content column - card padding
 * - 1331–1600px: two columns, cover ≈ 360–450px
 * - >1600px: two columns next to a 37.5vw panel
 */
const imageSizes = isSplit
  ? [
      "(max-width: 900px) calc(100vw - 80px)",
      "(max-width: 1330px) calc(76vw - 240px)",
      "(max-width: 1600px) 450px",
      "calc(31.25vw - 155px)",
    ].join(", ")
  : "(max-width: 400px) calc(100vw - 80px), 360px";
---

<Card class:list={["teaser", `teaser--${layout}`]} width={width} layout={layout}>
  <div class="teaser__heading">
    {
      date && (
        <time class="teaser__date page-label" datetime={date.toISOString().slice(0, 10)}>
          {date.toLocaleDateString("en-US", {
            month: "long",
            day: "numeric",
            year: "numeric",
            timeZone: "UTC",
          })}
        </time>
      )
    }
    <Heading class="teaser__title page-title-md">
      <a href={href}>{title}</a>
    </Heading>
  </div>
  <p class="teaser__description page-body">{description}</p>
  <a class="teaser__link" href={href}>Read article</a>

  {
    image && (
      <figure class="teaser__media" slot="media">
        <a class="teaser__image" href={href} tabindex="-1" aria-hidden="true">
          <Image
            src={image}
            alt={alt}
            widths={imageWidths}
            sizes={imageSizes}
            loading={eager ? "eager" : "lazy"}
          />
        </a>
        {tags.length > 0 && (
          <figcaption class="teaser__tags page-label">
            {tags.map((tag) => (
              <span>#{tag}</span>
            ))}
          </figcaption>
        )}
      </figure>
    )
  }
</Card>

<style>
  .teaser__heading {
    width: 100%;
    padding-bottom: 8px;
    display: flex;
    flex-direction: column;
    overflow-wrap: anywhere;
  }

  .teaser__date {
    color: var(--foreground-light);
  }

  .teaser__title {
    margin: 0;
    color: var(--foreground-strong);
  }

  .teaser__description {
    margin: 0;
    padding-bottom: 24px;
    color: var(--foreground-regular);
    overflow-wrap: anywhere;
  }

  .teaser__link {
    align-self: flex-start;
    color: var(--foreground-strong);
    font-family: var(--page-font-title);
    font-size: var(--page-body-size);
    font-weight: 700;
    line-height: var(--page-lineheight-compact);
  }

  .teaser a:hover {
    color: var(--foreground-link-hover);
  }

  .teaser__media {
    margin: 0;
    display: grid;
    gap: 4px;
  }

  .teaser__image {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-4);
    background: var(--foreground-inverse);
  }

  .teaser__image :global(img) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 240ms ease;
  }

  .teaser__image:hover :global(img) {
    transform: scale(1.03);
  }

  .teaser--split .teaser__image {
    aspect-ratio: 16 / 9;
  }

  .teaser--stack .teaser__image {
    width: 100%;
    max-width: 360px;
    aspect-ratio: 2 / 1;
    border: 1px solid var(--border-subtle);
  }

  .teaser__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0 4px;
    color: var(--foreground-light);
  }

  @media (prefers-reduced-motion: reduce) {
    .teaser__image :global(img) {
      transition: none;
    }
  }
</style>
