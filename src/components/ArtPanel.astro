---
/**
 * Hero panel: the sticky left column of the "split" layout (all main pages).
 * Holds the animated whiteboard (was: hero art image) and the glass bar with social
 * links and the theme switch. Hidden on mobile, where the page runs single-column.
 */
import ThemeToggle from "./ThemeToggle.astro";
import Whiteboard from "./Whiteboard.astro";
---

<div class="art-panel">
  <Whiteboard />
  <div class="art-panel__bar">
  <ul class="art-panel__links" aria-label="Social profiles">
    <li>
      <a href="https://linkedin.chriskuhrt.de/">LinkedIn</a>
    </li>
    <li>
      <a href="https://github.chriskuhrt.de/">GitHub</a>
    </li>
  </ul>
  <ThemeToggle variant="board" />
  </div>
</div>


<style>
.art-panel {
  position: sticky;
  /* Fast clicks on the theme switch must not select the artwork. */
  -webkit-user-select: none;
  user-select: none;
  top: 96px; /* header (16 + 64) + 16 */
  height: calc(100dvh - 112px);
  overflow: hidden;
  border-radius: 16px;
  background: var(--whiteboard-background);
}

/* Glass bar with social links and the theme switch (Figma "Social links").
   On the whiteboard it uses the header glass and normal text colours, so it reads on
   the light board as well as on the dark one. Provisional – design pending. */
.art-panel__bar {
  position: absolute;
  inset: auto 16px 16px;
  padding: 10px 10px 10px 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  border-radius: 8px;
  z-index: 1000;
  background: var(--background-header);
  /* Top highlight like the cards + a subtle edge. */
  box-shadow:
    inset 0 1px 0 var(--border-highlight),
    inset 0 0 0 1px var(--border-subtle);
  /* Prefixed first: the build's CSS minifier keeps only the last of the pair. */
  -webkit-backdrop-filter: blur(4px);
  backdrop-filter: blur(4px);
}

.art-panel__links {
  margin: 0;
  padding: 0;
  display: flex;
  flex-wrap: wrap; /* links drop to the next line when the panel gets narrow; the box grows upward */
  gap: 8px 32px;
  list-style: none;
}


.art-panel__links a {
  color: var(--foreground-strong);
  font-family: var(--page-font-body);
  font-size: var(--page-small-size);
  line-height: 24px;
}

.art-panel__links a:hover {
  color: var(--foreground-link-hover);
}
</style>
