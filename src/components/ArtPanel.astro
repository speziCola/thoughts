---
/**
 * Hero art panel: the sticky left column of the "split" layout (all main pages).
 * Hidden on mobile, where the page runs single-column.
 */
import { Image } from "astro:assets";
import heroArt from "../assets/images/hero-art.png";
---

<div class="art-panel">
  <Image
    class="art-panel__image"
    src={heroArt}
    alt=""
    widths={[480, 720, 1080, 1440]}
    sizes="(max-width: 900px) 100vw, 37.5vw"
    loading="eager"
  />
  <ul class="art-panel__links" aria-label="Social profiles">
    <li>
      <a href="https://linkedin.chriskuhrt.de/">LinkedIn</a>
    </li>
    <li>
      <a href="https://twitter.chriskuhrt.de/">Twitter</a>
    </li>
  </ul>
</div>

<style>
.art-panel {
  position: sticky;
  top: 96px; /* header (16 + 64) + 16 */
  height: calc(100dvh - 112px);
  overflow: hidden;
  border-radius: 16px;
  background: #1c3432;
}

.art-panel__image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: left bottom; /* crop from the top/right, keep the bottom-left corner */
}

/* Bottom gradient (Figma "Overlay"). */
.art-panel::after {
  content: "";
  position: absolute;
  inset: auto 0 0;
  height: 203px;
  background: linear-gradient(to top, rgb(0 0 0 / 40%), transparent);
  pointer-events: none;
}

/* Glass bar with social links (Figma "img-footer"). */
.art-panel__links {
  position: absolute;
  z-index: 1;
  inset: auto 16px 16px;
  margin: 0;
  padding: 16px;
  display: flex;
  gap: 32px;
  list-style: none;
  border-radius: 8px;
  background: rgb(255 255 255 / 20%);
  box-shadow:
    inset 0 1px 0 #fff,
    inset 0 0 0 1px rgb(255 255 255 / 50%);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}

.art-panel__links a {
  color: #fff;
  font-family: var(--page-font-body);
  font-size: 13px;
  line-height: 24px;
}

.art-panel__links a:hover {
  color: #00ffa3; /* brighter green, same as the footer links on dark */
}

.art-panel__links a:focus-visible {
  outline-color: #fff;
}
</style>
