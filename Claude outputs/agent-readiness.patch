diff --git a/src/components/WebMcp.astro b/src/components/WebMcp.astro
new file mode 100644
index 0000000..7c21bd6
--- /dev/null
+++ b/src/components/WebMcp.astro
@@ -0,0 +1,114 @@
+---
+/**
+ * WebMCP tools (https://developer.chrome.com/docs/ai/webmcp): lets an AI agent running
+ * in the visitor's browser query the site through structured, read-only tools instead
+ * of scraping the page.
+ *
+ * - search_posts: find articles by keyword and/or tag (from /thoughts/index.json)
+ * - get_post: full article as Markdown (/thoughts/<slug>/index.md)
+ * - get_profile: Christopher's professional profile (/llms.txt or /llms-full.txt)
+ *
+ * Progressive enhancement: does nothing in browsers without WebMCP (everything but
+ * Chrome with the API enabled). Data is fetched only when an agent calls a tool.
+ * Rendered once per page from BlogLayout.
+ */
+import { url } from "../lib/url";
+---
+
+<script
+  is:inline
+  data-webmcp
+  data-index={url("/thoughts/index.json")}
+  data-llms={url("/llms.txt")}
+  data-llms-full={url("/llms-full.txt")}
+  type="module"
+>
+  const mc = document.modelContext ?? navigator.modelContext;
+  // Module scripts have no document.currentScript, so read the URLs from the tag itself.
+  const config = document.querySelector("script[data-webmcp]")?.dataset ?? {};
+
+  if (mc && typeof mc.registerTool === "function") {
+    const fetchText = async (path, signal) => {
+      const response = await fetch(path, { signal });
+      if (!response.ok) throw new Error(`Could not load ${path} (${response.status}).`);
+      return response.text();
+    };
+
+    let indexPromise;
+    const loadIndex = (signal) =>
+      (indexPromise ??= fetchText(config.index, signal)
+        .then(JSON.parse)
+        .catch((error) => {
+          indexPromise = undefined;
+          throw error;
+        }));
+
+    const tools = [
+      {
+        name: "search_posts",
+        description:
+          "Search the articles Christopher Kuhrt has written on UX, research, design systems, design leadership and AI in product work. Returns matching articles (title, description, date, tags, URLs), newest first. Call without arguments to list all articles.",
+        inputSchema: {
+          type: "object",
+          properties: {
+            query: { type: "string", description: "Keywords to look for in titles, descriptions and tags." },
+            tag: { type: "string", description: "Only return articles with this tag, e.g. \"ux\" or \"research\"." },
+            limit: { type: "integer", minimum: 1, maximum: 50, description: "Maximum number of results (default 10)." },
+          },
+        },
+        annotations: { readOnlyHint: true },
+        execute: async ({ query = "", tag = "", limit = 10 } = {}, { signal } = {}) => {
+          const posts = await loadIndex(signal);
+          const words = String(query).toLowerCase().split(/\s+/).filter(Boolean);
+          const wantedTag = String(tag).toLowerCase().trim();
+          const hits = posts.filter((post) => {
+            if (wantedTag && !post.tags.some((t) => t.toLowerCase() === wantedTag)) return false;
+            const haystack = `${post.title} ${post.description} ${post.tags.join(" ")}`.toLowerCase();
+            return words.every((word) => haystack.includes(word));
+          });
+          return JSON.stringify({ total: hits.length, results: hits.slice(0, Math.max(1, Math.min(50, limit))) });
+        },
+      },
+      {
+        name: "get_post",
+        description:
+          "Get the full text of one of Christopher Kuhrt's articles as Markdown. Use the slug or URL from search_posts.",
+        inputSchema: {
+          type: "object",
+          properties: {
+            slug: { type: "string", description: "Article slug or full article URL, as returned by search_posts." },
+          },
+          required: ["slug"],
+        },
+        annotations: { readOnlyHint: true },
+        execute: async ({ slug } = {}, { signal } = {}) => {
+          const posts = await loadIndex(signal);
+          const key = String(slug ?? "").replace(/\/index\.md$/, "").replace(/\/+$/, "").split("/").pop();
+          const post = posts.find((p) => p.slug === key);
+          if (!post) return `No article found for "${slug}". Use search_posts to list available articles.`;
+          return fetchText(new URL(post.markdown).pathname, signal);
+        },
+      },
+      {
+        name: "get_profile",
+        description:
+          "Get Christopher Kuhrt's professional profile: current role, career history, expertise, projects, community work and links. Use detail \"full\" for the complete version with FAQs.",
+        inputSchema: {
+          type: "object",
+          properties: {
+            detail: { type: "string", enum: ["summary", "full"], description: "\"summary\" (default) or \"full\"." },
+          },
+        },
+        annotations: { readOnlyHint: true },
+        execute: async ({ detail = "summary" } = {}, { signal } = {}) =>
+          fetchText(detail === "full" ? config.llmsFull : config.llms, signal),
+      },
+    ];
+
+    for (const tool of tools) {
+      Promise.resolve()
+        .then(() => mc.registerTool(tool))
+        .catch((error) => console.warn(`WebMCP: could not register ${tool.name}`, error));
+    }
+  }
+</script>
