+/**
+ * Plain-Markdown version of each article at /thoughts/<slug>/index.md, for AI agents
+ * and LLMs. Linked from the article page via <link rel="alternate" type="text/markdown">,
+ * from /llms.txt, and returned by the WebMCP get_post tool.
+ */
+import type { APIRoute, GetStaticPaths } from "astro";
+import { getPosts, type Post } from "../../../lib/posts";
+import { markdownResponse, postAsMarkdownDocument } from "../../../lib/markdown";
+
+export const getStaticPaths: GetStaticPaths = async () => {
+  const posts = await getPosts();
+  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
+};
+
+export const GET: APIRoute = ({ props }) =>
+  markdownResponse(postAsMarkdownDocument((props as { post: Post }).post));
diff --git a/src/pages/thoughts/index.json.ts b/src/pages/thoughts/index.json.ts
new file mode 100644
index 0000000..178a9cc
--- /dev/null
+++ b/src/pages/thoughts/index.json.ts
@@ -0,0 +1,23 @@
+/**
+ * /thoughts/index.json: machine-readable article index (newest first).
+ * Used by the WebMCP tools (src/components/WebMcp.astro); also handy for any agent.
+ */
+import type { APIRoute } from "astro";
+import { getPosts } from "../../lib/posts";
+import { postMarkdownUrl, postUrl } from "../../lib/markdown";
+
+export const GET: APIRoute = async () => {
+  const posts = await getPosts();
+  const index = posts.map((post) => ({
+    slug: post.slug,
+    title: post.seoTitle,
+    description: post.description,
+    date: post.date.toISOString().slice(0, 10),
+    tags: post.tags,
+    url: postUrl(post),
+    markdown: postMarkdownUrl(post),
+  }));
+  return new Response(JSON.stringify(index), {
+    headers: { "Content-Type": "application/json; charset=utf-8" },
+  });
+};
