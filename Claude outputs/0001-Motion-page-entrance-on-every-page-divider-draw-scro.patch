+/* Page entrance: on every page load the content column fades in and slides in
+   slightly from the right, as one block. Header, art panel and footer stay put.
+   Fill "backwards" only: once finished, no transform is left on <main>, so sticky
+   and fixed children behave normally. Pages opt out with entrance="none". */
+@keyframes page-enter {
+  from {
+    opacity: 0;
+    translate: 24px 0;
+  }
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  main[data-entrance="page"] {
+    animation: page-enter 700ms cubic-bezier(0.22, 1, 0.36, 1) backwards;
+  }
+}
+
 /* Title styles: Fira Sans semibold. */
