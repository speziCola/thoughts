+<script>
+  // Scroll reveal for everything below the areas: each block fades and slides up
+  // once it scrolls into view. Blocks already visible on load join the entrance
+  // choreography (after the area cards, before the divider, see home.css).
+  const blocks = document.querySelectorAll<HTMLElement>("[data-reveal]");
+  const INITIAL_START = 1.4; // s
+  const INITIAL_STEP = 0.1; // s between blocks visible on load
+
+  if (!("IntersectionObserver" in window)) {
+    blocks.forEach((block) => block.classList.add("is-revealed"));
+  } else {
+    let initial = true;
+    const observer = new IntersectionObserver(
+      (entries) => {
+        let index = 0;
+        for (const entry of entries) {
+          if (!entry.isIntersecting) continue;
+          const block = entry.target as HTMLElement;
+          if (initial) block.style.setProperty("--reveal-delay", `${INITIAL_START + INITIAL_STEP * index++}s`);
+          block.classList.add("is-revealed");
+          observer.unobserve(block);
+        }
+        initial = false;
+      },
+      { rootMargin: "0px 0px -10% 0px" },
+    );
+    blocks.forEach((block) => observer.observe(block));
+  }
+</script>
